---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Writing by Your Name" />
    <title>{title}</title>

    <style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #fff;
    color: #222;
    font-family: Georgia, "Times New Roman", serif;
    line-height: 1.75;
    font-size: 17px;
  }

  :global(main) {
    width: min(680px, calc(100% - 40px));
    margin: 64px auto 100px;
  }

  :global(nav) {
    display: flex;
    gap: 20px;
    margin-bottom: 72px;
    font-size: 15px;
  }

  :global(nav a) {
    color: inherit;
    text-decoration: none;
  }

  :global(nav a:hover) {
    text-decoration: underline;
  }

  :global(h1) {
    font-size: 2rem;
    line-height: 1.2;
    margin: 0 0 24px;
  }

  :global(h2) {
    font-size: 1.25rem;
    line-height: 1.3;
    margin: 56px 0 24px;
  }

  :global(p) {
    margin: 0 0 24px;
  }

  :global(a) {
    color: inherit;
  }

  @media (max-width: 700px) {
    :global(main) {
      width: min(100% - 28px, 680px);
      margin-top: 36px;
    }

    :global(nav) {
      margin-bottom: 52px;
    }

    :global(body) {
      font-size: 16px;
    }
  }
</style>
  </head>

  <body>
    <main>
      <nav>
        <a href="/">Home</a>
        <a href="/about">About</a>
      </nav>

      <slot />
    </main>
  </body>
</html>